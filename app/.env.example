# Required
JWT_SECRET=change-this-to-a-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Database (defaults to ./data/osint.db)
DB_PATH=./data/osint.db

# Optional API keys (tools degrade gracefully without them)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
HIBP_API_KEY=
URLSCAN_API_KEY=

# SpiderFoot (internal Docker URL)
SPIDERFOOT_URL=http://spiderfoot:5001

# App URL (for CORS / cookies)
NEXT_PUBLIC_APP_URL=https://your-domain.example.com
